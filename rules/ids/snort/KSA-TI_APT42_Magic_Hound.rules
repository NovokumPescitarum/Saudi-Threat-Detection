# MISP export of IDS rules - optimized for snort
#
# These NIDS rules contain some variables that need to exist in your configuration.
# Make sure you have set:
#
# $HOME_NET     - Your internal network range
# $EXTERNAL_NET - The network considered as outside
# $SMTP_SERVERS - All your internal SMTP servers
# $HTTP_PORTS   - The ports used to contain HTTP traffic (not required with suricata export)
# 
alert udp any any -> any 53 (msg: "MISP e3456 [source:otx,actor:APT42/Magic Hound] Domain: timezone.live"; content:"|01 00 00 01 00 00 00 00 00 01|"; depth:10; offset:2; content:"|08|timezone|04|live|00|"; fast_pattern; nocase;  classtype:bad-unknown; sid:10909461; rev:1; priority:2; reference:url,https://misp.ali/events/view/3456;) 
alert tcp any any -> any 53 (msg: "MISP e3456 [source:otx,actor:APT42/Magic Hound] Domain: timezone.live"; content:"|01 00 00 01 00 00 00 00 00 01|"; depth:10; offset:2; content:"|08|timezone|04|live|00|"; fast_pattern; nocase; flow:established;  classtype:bad-unknown; sid:10909462; rev:1; priority:2; reference:url,https://misp.ali/events/view/3456;) 
alert tcp $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS (msg: "MISP e3456 [source:otx,actor:APT42/Magic Hound] Outgoing HTTP Domain: timezone.live"; flow:to_server,established; content: "Host|3a|"; nocase; http_header; content:"timezone.live"; fast_pattern; nocase; http_header; pcre: "/(^|[^A-Za-z0-9-])timezone\.live[^A-Za-z0-9-\.]/H"; tag:session,600,seconds; classtype:bad-unknown; sid:10909463; rev:1; priority:2; reference:url,https://misp.ali/events/view/3456;) 
