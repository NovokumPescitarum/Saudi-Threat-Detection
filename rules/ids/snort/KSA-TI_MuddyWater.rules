# MISP export of IDS rules - optimized for snort
#
# These NIDS rules contain some variables that need to exist in your configuration.
# Make sure you have set:
#
# $HOME_NET     - Your internal network range
# $EXTERNAL_NET - The network considered as outside
# $SMTP_SERVERS - All your internal SMTP servers
# $HTTP_PORTS   - The ports used to contain HTTP traffic (not required with suricata export)
# 
alert udp any any -> any 53 (msg: "MISP e3460 [source:otx,actor:MuddyWater] Domain: webmail.lax.co.il"; content:"|01 00 00 01 00 00 00 00 00 01|"; depth:10; offset:2; content:"|07|webmail|03|lax|02|co|02|il|00|"; fast_pattern; nocase;  classtype:bad-unknown; sid:10912201; rev:1; priority:2; reference:url,https://misp.ali/events/view/3460;) 
alert tcp any any -> any 53 (msg: "MISP e3460 [source:otx,actor:MuddyWater] Domain: webmail.lax.co.il"; content:"|01 00 00 01 00 00 00 00 00 01|"; depth:10; offset:2; content:"|07|webmail|03|lax|02|co|02|il|00|"; fast_pattern; nocase; flow:established;  classtype:bad-unknown; sid:10912202; rev:1; priority:2; reference:url,https://misp.ali/events/view/3460;) 
alert tcp $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS (msg: "MISP e3460 [source:otx,actor:MuddyWater] Outgoing HTTP Domain: webmail.lax.co.il"; flow:to_server,established; content: "Host|3a|"; nocase; http_header; content:"webmail.lax.co.il"; fast_pattern; nocase; http_header; pcre: "/(^|[^A-Za-z0-9-])webmail\.lax\.co\.il[^A-Za-z0-9-\.]/H"; tag:session,600,seconds; classtype:bad-unknown; sid:10912203; rev:1; priority:2; reference:url,https://misp.ali/events/view/3460;) 
