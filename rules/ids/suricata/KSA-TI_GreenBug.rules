# MISP export of IDS rules - optimized for suricata
#
# These NIDS rules contain some variables that need to exist in your configuration.
# Make sure you have set:
#
# $HOME_NET     - Your internal network range
# $EXTERNAL_NET - The network considered as outside
# $SMTP_SERVERS - All your internal SMTP servers
# $HTTP_PORTS   - The ports used to contain HTTP traffic (not required with suricata export)
# 
alert dns any any -> any any (msg: "MISP e3458 Domain winappupdater.com"; dns.query; content:"winappupdater.com"; startswith; endswith;  classtype:bad-unknown; sid:10911631; rev:1; priority:2; reference:url,https://misp.ali/events/view/3458; metadata:source otx,actor GreenBug,misp_event_uuid fb364029-7a99-48f8-a483-1e3132774441,misp_ioc winappupdater.com,created_at 2026_10_10,updated_at 2026_10_10;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg: "MISP e3458 Outgoing HTTP Domain winappupdater.com"; flow:to_server,established; http.host; content:"winappupdater.com"; startswith; endswith; tag:session,600,seconds; classtype:bad-unknown; sid:10911632; rev:1; priority:2; reference:url,https://misp.ali/events/view/3458; metadata:source otx,actor GreenBug,misp_event_uuid fb364029-7a99-48f8-a483-1e3132774441,misp_ioc winappupdater.com,created_at 2026_10_10,updated_at 2026_10_10;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg: "MISP e3458 Outgoing HTTPS Domain winappupdater.com"; flow:to_server,established; tls.sni; content:"winappupdater.com"; startswith; endswith; tag:session,600,seconds; classtype:bad-unknown; sid:10911633; rev:1; priority:2; reference:url,https://misp.ali/events/view/3458; metadata:source otx,actor GreenBug,misp_event_uuid fb364029-7a99-48f8-a483-1e3132774441,misp_ioc winappupdater.com,created_at 2026_10_10,updated_at 2026_10_10;)
