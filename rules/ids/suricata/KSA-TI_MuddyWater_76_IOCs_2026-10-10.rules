# MISP export of IDS rules - optimized for suricata
#
# These NIDS rules contain some variables that need to exist in your configuration.
# Make sure you have set:
#
# $HOME_NET     - Your internal network range
# $EXTERNAL_NET - The network considered as outside
# $SMTP_SERVERS - All your internal SMTP servers
# $HTTP_PORTS   - The ports used to contain HTTP traffic (not required with suricata export)
# 
alert dns any any -> any any (msg: "MISP e3451 Domain webmail.lax.co.il"; dns.query; content:"webmail.lax.co.il"; startswith; endswith;  classtype:bad-unknown; sid:10882831; rev:1; priority:2; reference:url,https://misp.ali/events/view/3451; metadata:source otx,actor MuddyWater,misp_event_uuid 0675a4ce-950a-49e8-ab80-28469bd40c08,misp_ioc webmail.lax.co.il,created_at 2026_10_10,updated_at 2026_10_10;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg: "MISP e3451 Outgoing HTTP Domain webmail.lax.co.il"; flow:to_server,established; http.host; content:"webmail.lax.co.il"; startswith; endswith; tag:session,600,seconds; classtype:bad-unknown; sid:10882832; rev:1; priority:2; reference:url,https://misp.ali/events/view/3451; metadata:source otx,actor MuddyWater,misp_event_uuid 0675a4ce-950a-49e8-ab80-28469bd40c08,misp_ioc webmail.lax.co.il,created_at 2026_10_10,updated_at 2026_10_10;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg: "MISP e3451 Outgoing HTTPS Domain webmail.lax.co.il"; flow:to_server,established; tls.sni; content:"webmail.lax.co.il"; startswith; endswith; tag:session,600,seconds; classtype:bad-unknown; sid:10882833; rev:1; priority:2; reference:url,https://misp.ali/events/view/3451; metadata:source otx,actor MuddyWater,misp_event_uuid 0675a4ce-950a-49e8-ab80-28469bd40c08,misp_ioc webmail.lax.co.il,created_at 2026_10_10,updated_at 2026_10_10;)
