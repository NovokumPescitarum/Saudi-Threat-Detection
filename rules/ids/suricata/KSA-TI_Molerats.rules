# MISP export of IDS rules - optimized for suricata
#
# These NIDS rules contain some variables that need to exist in your configuration.
# Make sure you have set:
#
# $HOME_NET     - Your internal network range
# $EXTERNAL_NET - The network considered as outside
# $SMTP_SERVERS - All your internal SMTP servers
# $HTTP_PORTS   - The ports used to contain HTTP traffic (not required with suricata export)
# 
alert dns any any -> any any (msg: "MISP e3459 Domain hint.zapto.org"; dns.query; content:"hint.zapto.org"; startswith; endswith;  classtype:bad-unknown; sid:10911981; rev:1; priority:2; reference:url,https://misp.ali/events/view/3459; metadata:source otx,actor Molerats,misp_event_uuid c1a2917c-e75a-4b35-b962-b47927fa6a7c,misp_ioc hint.zapto.org,created_at 2026_10_10,updated_at 2026_10_10;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg: "MISP e3459 Outgoing HTTP Domain hint.zapto.org"; flow:to_server,established; http.host; content:"hint.zapto.org"; startswith; endswith; tag:session,600,seconds; classtype:bad-unknown; sid:10911982; rev:1; priority:2; reference:url,https://misp.ali/events/view/3459; metadata:source otx,actor Molerats,misp_event_uuid c1a2917c-e75a-4b35-b962-b47927fa6a7c,misp_ioc hint.zapto.org,created_at 2026_10_10,updated_at 2026_10_10;)
