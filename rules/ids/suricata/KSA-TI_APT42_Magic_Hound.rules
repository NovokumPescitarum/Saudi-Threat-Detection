# MISP export of IDS rules - optimized for suricata
#
# These NIDS rules contain some variables that need to exist in your configuration.
# Make sure you have set:
#
# $HOME_NET     - Your internal network range
# $EXTERNAL_NET - The network considered as outside
# $SMTP_SERVERS - All your internal SMTP servers
# $HTTP_PORTS   - The ports used to contain HTTP traffic (not required with suricata export)
# 
alert dns any any -> any any (msg: "MISP e3456 Domain timezone.live"; dns.query; content:"timezone.live"; startswith; endswith;  classtype:bad-unknown; sid:10909461; rev:1; priority:2; reference:url,https://misp.ali/events/view/3456; metadata:source otx,actor APT42/Magic_Hound,misp_event_uuid 064fcdfc-2c6d-4f3f-bad4-089237b89744,misp_ioc timezone.live,created_at 2026_10_10,updated_at 2026_10_10;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg: "MISP e3456 Outgoing HTTP Domain timezone.live"; flow:to_server,established; http.host; content:"timezone.live"; startswith; endswith; tag:session,600,seconds; classtype:bad-unknown; sid:10909462; rev:1; priority:2; reference:url,https://misp.ali/events/view/3456; metadata:source otx,actor APT42/Magic_Hound,misp_event_uuid 064fcdfc-2c6d-4f3f-bad4-089237b89744,misp_ioc timezone.live,created_at 2026_10_10,updated_at 2026_10_10;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg: "MISP e3456 Outgoing HTTPS Domain timezone.live"; flow:to_server,established; tls.sni; content:"timezone.live"; startswith; endswith; tag:session,600,seconds; classtype:bad-unknown; sid:10909463; rev:1; priority:2; reference:url,https://misp.ali/events/view/3456; metadata:source otx,actor APT42/Magic_Hound,misp_event_uuid 064fcdfc-2c6d-4f3f-bad4-089237b89744,misp_ioc timezone.live,created_at 2026_10_10,updated_at 2026_10_10;)
