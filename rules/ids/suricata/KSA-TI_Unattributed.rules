# MISP export of IDS rules - optimized for suricata
#
# These NIDS rules contain some variables that need to exist in your configuration.
# Make sure you have set:
#
# $HOME_NET     - Your internal network range
# $EXTERNAL_NET - The network considered as outside
# $SMTP_SERVERS - All your internal SMTP servers
# $HTTP_PORTS   - The ports used to contain HTTP traffic (not required with suricata export)
# 
alert dns any any -> any any (msg: "MISP e3476 Domain soholat.sa"; dns.query; content:"soholat.sa"; startswith; endswith;  classtype:bad-unknown; sid:10966371; rev:1; priority:2; reference:url,https://misp.ali/events/view/3476; metadata:source threatfox,misp_event_uuid e1133353-39e6-4820-837b-847875e2706d,misp_ioc soholat.sa,created_at 2026_10_10,updated_at 2026_10_10;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg: "MISP e3476 Outgoing HTTP Domain soholat.sa"; flow:to_server,established; http.host; content:"soholat.sa"; startswith; endswith; tag:session,600,seconds; classtype:bad-unknown; sid:10966372; rev:1; priority:2; reference:url,https://misp.ali/events/view/3476; metadata:source threatfox,misp_event_uuid e1133353-39e6-4820-837b-847875e2706d,misp_ioc soholat.sa,created_at 2026_10_10,updated_at 2026_10_10;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg: "MISP e3476 Outgoing HTTPS Domain soholat.sa"; flow:to_server,established; tls.sni; content:"soholat.sa"; startswith; endswith; tag:session,600,seconds; classtype:bad-unknown; sid:10966373; rev:1; priority:2; reference:url,https://misp.ali/events/view/3476; metadata:source threatfox,misp_event_uuid e1133353-39e6-4820-837b-847875e2706d,misp_ioc soholat.sa,created_at 2026_10_10,updated_at 2026_10_10;)