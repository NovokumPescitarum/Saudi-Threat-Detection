# MISP export of IDS rules - optimized for suricata
#
# These NIDS rules contain some variables that need to exist in your configuration.
# Make sure you have set:
#
# $HOME_NET     - Your internal network range
# $EXTERNAL_NET - The network considered as outside
# $SMTP_SERVERS - All your internal SMTP servers
# $HTTP_PORTS   - The ports used to contain HTTP traffic (not required with suricata export)
# 
alert dns any any -> any any (msg: "MISP e3455 Domain go0gie.com"; dns.query; content:"go0gie.com"; startswith; endswith;  classtype:bad-unknown; sid:10907901; rev:1; priority:2; reference:url,https://misp.ali/events/view/3455; metadata:source otx,actor APT34/OilRig,misp_event_uuid dac2fc53-0699-4897-80b2-394296e2b0bf,misp_ioc go0gie.com,created_at 2026_10_10,updated_at 2026_10_10;)
