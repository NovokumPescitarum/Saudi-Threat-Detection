# MISP export of IDS rules - optimized for suricata
#
# These NIDS rules contain some variables that need to exist in your configuration.
# Make sure you have set:
#
# $HOME_NET     - Your internal network range
# $EXTERNAL_NET - The network considered as outside
# $SMTP_SERVERS - All your internal SMTP servers
# $HTTP_PORTS   - The ports used to contain HTTP traffic (not required with suricata export)
# 
alert dns any any -> any any (msg: "MISP e3454 Domain www.chromup.com"; dns.query; content:"www.chromup.com"; startswith; endswith;  classtype:bad-unknown; sid:10907371; rev:1; priority:2; reference:url,https://misp.ali/events/view/3454; metadata:source otx,actor APT33/Elfin,misp_event_uuid 40208339-f59b-4c72-bfe9-db4d1e5383ca,misp_ioc www.chromup.com,created_at 2026_10_10,updated_at 2026_10_10;)
