# MISP export of IDS rules - optimized for suricata
#
# These NIDS rules contain some variables that need to exist in your configuration.
# Make sure you have set:
#
# $HOME_NET     - Your internal network range
# $EXTERNAL_NET - The network considered as outside
# $SMTP_SERVERS - All your internal SMTP servers
# $HTTP_PORTS   - The ports used to contain HTTP traffic (not required with suricata export)
# 
alert dns any any -> any any (msg: "MISP e3447 Domain timezone.live"; dns.query; content:"timezone.live"; startswith; endswith;  classtype:bad-unknown; sid:10880091; rev:1; priority:2; reference:url,https://misp.ali/events/view/3447; metadata:source otx,actor APT42/Magic_Hound,misp_event_uuid 22715513-8515-4458-9df9-18cee138fdae,misp_ioc timezone.live,created_at 2026_10_10,updated_at 2026_10_10;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg: "MISP e3447 Outgoing HTTP Domain timezone.live"; flow:to_server,established; http.host; content:"timezone.live"; startswith; endswith; tag:session,600,seconds; classtype:bad-unknown; sid:10880092; rev:1; priority:2; reference:url,https://misp.ali/events/view/3447; metadata:source otx,actor APT42/Magic_Hound,misp_event_uuid 22715513-8515-4458-9df9-18cee138fdae,misp_ioc timezone.live,created_at 2026_10_10,updated_at 2026_10_10;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg: "MISP e3447 Outgoing HTTPS Domain timezone.live"; flow:to_server,established; tls.sni; content:"timezone.live"; startswith; endswith; tag:session,600,seconds; classtype:bad-unknown; sid:10880093; rev:1; priority:2; reference:url,https://misp.ali/events/view/3447; metadata:source otx,actor APT42/Magic_Hound,misp_event_uuid 22715513-8515-4458-9df9-18cee138fdae,misp_ioc timezone.live,created_at 2026_10_10,updated_at 2026_10_10;)
